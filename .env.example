# Project Settings > Environment Variables, Production/Preview/Development
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DB?sslmode=require
SITE_URL=https://a2pdistribution.com
ADMIN_EMAIL=admin@example.com
# Generate with: npm run hash:password -- "your-new-long-password"
ADMIN_PASSWORD_HASH=$2b$12$YOUR_BCRYPT_HASH
# Use e.g. openssl rand -base64 48
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Vercel Blob storage: required to upload durable images/PDFs from admin
BLOB_READ_WRITE_TOKEN=
